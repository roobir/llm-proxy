# Copy to .env and fill in. Required for the app to start:
DASHBOARD_USERNAME=admin
# Generate with: python scripts/hash_password.py
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=

# --- Optional: bootstrap an AI gateway from env vars instead of the ---
# --- /admin/settings GUI. Either block below, or leave both blank and ---
# --- configure everything from Settings after your first login. ---

# Option A: Cloudflare Workers AI via a named AI Gateway
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_AIG_GATEWAY_ID=
# CF_MODEL=@cf/qwen/qwen3.8-27b

# Option B: any other OpenAI-compatible provider
# GATEWAY_NAME=OpenAI
# GATEWAY_BASE_URL=https://api.openai.com/v1/chat/completions
# GATEWAY_API_KEY=
# GATEWAY_EXTRA_HEADERS=
# GATEWAY_DEFAULT_MODEL=gpt-4o-mini

# --- Optional tuning (all have sane defaults) ---
# REDIS_URL=redis://redis:6379/0
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# SELFTEST_PROMPT=Reply with the single word: ok
